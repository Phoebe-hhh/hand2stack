  <question type="stack">
    <name>
      <text>H2S Algebraic 05 - 分式与根式方程</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[
        <p>精确求解方程</p>
        <p>\[\frac{x}{3}+\sqrt2=5.\]</p>
        <p>请将答案写成方程。</p>
        <p>[[input:ans1]] [[validation:ans1]]</p>
      ]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>正确答案是 \(x=15-3\sqrt2\)。</p>]]></text>
