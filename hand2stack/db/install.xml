<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/hand2stack/db" VERSION="2026100400" COMMENT="XMLDB file for local_hand2stack"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_hand2stack_sess" COMMENT="Mobile upload sessions for Hand2STACK">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="waiting" SEQUENCE="false"/>
        <FIELD NAME="rawlatex" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="rawascii" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="rawtext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="stack" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="resulttext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="expiresat" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionid_uix" UNIQUE="true" FIELDS="sessionid"/>
        <INDEX NAME="userid_ix" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="expiresat_ix" UNIQUE="false" FIELDS="expiresat"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
